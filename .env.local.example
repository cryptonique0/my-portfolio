# Environment Variables Template
# Copy this file to .env.local and fill in your values

# ============ WALLET CONFIGURATION ============
# Your private key for contract deployment (keep secure!)
PRIVATE_KEY=your_private_key_without_0x_prefix

# ============ RPC ENDPOINTS ============
# Base Network
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Ethereum Network
MAINNET_RPC_URL=https://eth.llamarpc.com
SEPOLIA_RPC_URL=https://eth-sepolia.public.blastapi.io

# Stacks Network (Bitcoin L2)
STACKS_MAINNET_RPC_URL=https://mainnet.stacks.co:20443
STACKS_TESTNET_RPC_URL=https://testnet-api.stacks.co

# ============ BLOCK EXPLORER API KEYS ============
# Get these from:
# - Basescan: https://basescan.org/apis
# - Etherscan: https://etherscan.io/apis
BASESCAN_API_KEY=your_basescan_api_key
ETHERSCAN_API_KEY=your_etherscan_api_key

# ============ WEB3MODAL CONFIGURATION ============
# Get from: https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# ============ CONTRACT ADDRESSES ============
# EVM Contracts (Base, Ethereum)
NEXT_PUBLIC_CONTRACT_ADDRESS=0x1234567890123456789012345678901234567890
NEXT_PUBLIC_REPUTATION_TOKEN=0x0987654321098765432109876543210987654321

# Stacks Contracts - Mainnet
NEXT_PUBLIC_STACKS_RESUME_CONTRACT=SP2PABQ3KSQSN94KH6MQQCSJS4P72TMVS3EJ7BFF8
NEXT_PUBLIC_STACKS_ACHIEVEMENT_NFT=SP2PABQ3KSQSN94KH6MQQCSJS4P72TMVS3EJ7BFF8
NEXT_PUBLIC_STACKS_VERIFIER=SP2PABQ3KSQSN94KH6MQQCSJS4P72TMVS3EJ7BFF8

# Stacks Contracts - Testnet
NEXT_PUBLIC_STACKS_RESUME_CONTRACT_TESTNET=ST2PABQ3KSQSN94KH6MQQCSJS4P72TMVS3EJ7BFF8
NEXT_PUBLIC_STACKS_ACHIEVEMENT_NFT_TESTNET=ST2PABQ3KSQSN94KH6MQQCSJS4P72TMVS3EJ7BFF8
NEXT_PUBLIC_STACKS_VERIFIER_TESTNET=ST2PABQ3KSQSN94KH6MQQCSJS4P72TMVS3EJ7BFF8

# ============ IPFS CONFIGURATION ============
# Using Pinata as example
NEXT_PUBLIC_IPFS_API_URL=https://api.pinata.cloud/pinning/pinFileToIPFS
IPFS_API_KEY=your_pinata_api_key
IPFS_API_SECRET=your_pinata_secret_key

# Alternative IPFS providers:
# Infura: https://www.infura.io/
# NFT.storage: https://nft.storage/

# ============ OPTIONAL: GAS REPORTER ============
# Set to true to generate gas reports during tests
REPORT_GAS=true
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key

# ============ APPLICATION SETTINGS ============
# Default network on app launch
NEXT_PUBLIC_DEFAULT_NETWORK=base_mainnet

# Enable testnet mode for development
NEXT_PUBLIC_TESTNET_MODE=false

# IPFS gateway for reading files
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# ============ OPTIONAL: ANALYTICS ============
# Google Analytics (optional)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=your_ga_id

# Amplitude (optional)
NEXT_PUBLIC_AMPLITUDE_API_KEY=your_amplitude_key

# ============ NOTES ============
# 1. NEVER commit this file with real values to git
# 2. Add .env.local to .gitignore
# 3. Use different keys for development vs production
# 4. For production, use environment secrets in your deployment platform
# 5. Rotate API keys regularly

# ============ TESTING CREDENTIALS ============
# For development/testing only - DO NOT USE IN PRODUCTION
# Test accounts with funds on various testnets:
# - Base Sepolia Faucet: https://faucet.circle.com/
# - Ethereum Sepolia Faucet: https://www.sepoliafaucet.com/
# - Stacks Testnet Faucet: https://faucet.testnet.stacks.co/

